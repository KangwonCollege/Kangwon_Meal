# MySQL 설정 (DB_USER, DB_PASSWORD, DB_NAME 중 하나라도 비어 있으면 SQLite로 자동 전환)
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# SQLite 설정 (MySQL 미설정 시 사용)
DB_PATH=./kangwon_meal.db

# Cloud SQL 설정 (Cloud Run 배포 시 사용, TCP 대신 Unix 소켓으로 연결)
# DB_HOST는 비워두고 아래 항목만 입력하면 됩니다.
# 형식: PROJECT_ID:REGION:INSTANCE_NAME
CLOUD_SQL_INSTANCE=
